{
 "a1": "مَرْحَباً! رُوبُوتٌ يَتْبَعُ الخَطَّ.",
 "b1": "أَرْدُوِينُو",
 "b2": "المُشَغِّلُ",
 "b3": "مُسْتَشْعِرَانِ",
 "b4": "مُحَرِّكَانِ",
 "b5": "الهَيْكَلُ",
 "b6": "البَطَّارِيَّةُ",
 "c1": "الأَبْيَضُ يَعْكِسُ الضَّوْءَ: صِفْرٌ. الأَسْوَدُ يَمْتَصُّهُ: وَاحِدٌ.",
 "c2": "المُحَرِّكُ يَحْتَاجُ تَيَّاراً أَكْبَرَ، فَنَسْتَعْمِلُ مُشَغِّلاً.",
 "c3": "مَدْخَلَا الاتِّجَاهِ يُحَدِّدَانِ الدَّوَرَانَ، وَالتَّمْكِينُ السُّرْعَةَ.",
 "c4": "النَّبَضَاتُ تَضْبِطُ القُوَّةَ.",
 "d1": "المُحَرِّكَاتُ وَالعَجَلَاتُ.",
 "d2": "المُسْتَشْعِرَاتُ أَمَامَ الهَيْكَلِ.",
 "d3": "الأَرْدُوِينُو وَالمُشَغِّلُ وَالبَطَّارِيَّةُ.",
 "d4": "المُحَرِّكَاتُ إِلَى المُشَغِّلِ.",
 "d5": "المُسْتَشْعِرَاتُ إِلَى المَنْفَذَيْنِ اثْنَيْنِ وَثَلَاثَةٍ.",
 "d6": "المُشَغِّلُ إِلَى المَنَافِذِ خَمْسَةٍ إِلَى عَشَرَةٍ.",
 "d7": "البَطَّارِيَّةُ تُغَذِّي المُشَغِّلَ، وَالأَرْضُ مُشْتَرَكَةٌ.",
 "d8": "نَنْزِعُ القَاطِعَيْنِ.",
 "d9": "جَاهِزٌ!",
 "e0": "لِكُلِّ مُحَرِّكٍ سُرْعَةٌ: مُوجَبَةٌ لِلْأَمَامِ، سَالِبَةٌ لِلْخَلْفِ.",
 "e1": "وَاحِدٌ عَلَى الأَسْوَدِ، صِفْرٌ عَلَى الأَبْيَضِ.",
 "e2": "صِفْرٌ وَصِفْرٌ: إِلَى الأَمَامِ.",
 "e3": "الأَيْسَرُ يَرَى الخَطَّ: يَسَاراً.",
 "e4": "الأَيْمَنُ يَرَى الخَطَّ: يَمِيناً.",
 "e5": "الاثْنَانِ أَسْوَدُ: تَوَقُّفٌ.",
 "e6": "وَتَتَكَرَّرُ مِئَاتِ المَرَّاتِ فِي الثَّانِيَةِ.",
 "f1": "الكَابِلُ، ثُمَّ اللَّوْحَةُ وَالمَنْفَذُ.",
 "f2": "وَنَرْفَعُ البَرْنَامَجَ.",
 "g1": "الرُّوبُوتُ يَتْبَعُ الخَطَّ بِنَفْسِهِ.",
 "g2": "وَيَتَوَقَّفُ عِنْدَ الخَطِّ العَرِيضِ.",
